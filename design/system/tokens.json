{
  "$schema": "https://design-tokens.org/draft",
  "name": "VipKorner Design System",
  "direction": "Midnight Marquee",
  "version": "1.0.0",
  "constraints": {
    "excludedHues": ["purple 255-330deg", "teal/cyan 155-205deg"],
    "note": "The retired --plum #7d3d6a is replaced by gold #E8B455 in every role."
  },

  "color": {
    "primitive": {
      "ink": {
        "000": { "value": "#08080A", "use": "app canvas" },
        "050": { "value": "#0E0E11", "use": "translucent chrome base" },
        "100": { "value": "#121216", "use": "default surface" },
        "150": { "value": "#17171C", "use": "hover fill" },
        "200": { "value": "#1C1C22", "use": "raised: menus, inputs, media letterbox" },
        "300": { "value": "#24242B", "use": "overlay: modals" },
        "400": { "value": "#33333C", "use": "pressed, skeleton highlight" },
        "500": { "value": "#4A4A54", "use": "disabled fill" },
        "600": { "value": "#6B6B76", "use": "strong border", "contrast": { "on-ink-200": 3.22 } },
        "700": { "value": "#948E87", "use": "subtle text", "contrast": { "on-ink-300": 4.76, "on-ink-100": 5.76 } },
        "800": { "value": "#A9A39C", "use": "muted text", "contrast": { "on-ink-300": 6.17, "on-ink-100": 7.48 } },
        "900": { "value": "#F6F3EF", "use": "primary text", "contrast": { "on-ink-300": 13.94, "on-ink-000": 18.09 } }
      },
      "gold": {
        "100": { "value": "#FBEFD6" },
        "300": { "value": "#F3D08A", "use": "focus ring", "contrast": { "on-ink-100": 12.64 } },
        "500": { "value": "#E8B455", "use": "brand", "contrast": { "on-ink-100": 9.87 } },
        "700": { "value": "#B8853A" },
        "900": { "value": "#7A5722" }
      },
      "rose": {
        "100": { "value": "#FBD9E1" },
        "300": { "value": "#F49BAF", "contrast": { "on-ink-200": 8.20 } },
        "500": { "value": "#E9506F", "use": "like / active story", "contrast": { "on-ink-100": 5.20 } },
        "700": { "value": "#C22C4C", "use": "badge fill", "contrast": { "white-on-fill": 5.59 } },
        "900": { "value": "#7C1A2E" }
      },
      "ember": {
        "300": { "value": "#F7A98D" },
        "500": { "value": "#F0704A", "use": "gradient partner only — never a lone signal" },
        "700": { "value": "#C1502E" }
      },
      "green": {
        "300": { "value": "#A5D2A8" },
        "500": { "value": "#6FB574", "use": "success", "contrast": { "on-ink-100": 7.60 } },
        "700": { "value": "#3F7C46" }
      },
      "red": {
        "300": { "value": "#F09189", "use": "danger text", "contrast": { "on-ink-100": 8.11 } },
        "500": { "value": "#E5544A", "contrast": { "on-ink-100": 5.07 } },
        "700": { "value": "#C4362C", "use": "danger fill", "contrast": { "white-on-fill": 5.37 } }
      },
      "alpha": {
        "04": { "value": "rgba(255,255,255,.04)" },
        "07": { "value": "rgba(255,255,255,.07)" },
        "10": { "value": "rgba(255,255,255,.10)" },
        "14": { "value": "rgba(255,255,255,.14)" },
        "18": { "value": "rgba(255,255,255,.18)" },
        "28": { "value": "rgba(255,255,255,.28)" },
        "40": { "value": "rgba(255,255,255,.40)" }
      }
    },
    "semantic": {
      "bg": "{color.primitive.ink.000}",
      "surface": "{color.primitive.ink.100}",
      "surface-hover": "{color.primitive.ink.150}",
      "surface-raised": "{color.primitive.ink.200}",
      "surface-overlay": "{color.primitive.ink.300}",
      "surface-pressed": "{color.primitive.ink.400}",
      "surface-disabled": "{color.primitive.ink.500}",
      "text": "{color.primitive.ink.900}",
      "text-muted": "{color.primitive.ink.800}",
      "text-subtle": "{color.primitive.ink.700}",
      "text-disabled": "{color.primitive.ink.600}",
      "text-on-brand": "#12100B",
      "text-on-accent": "#FFFFFF",
      "text-on-danger": "#FFFFFF",
      "border-subtle": "{color.primitive.alpha.10}",
      "border": "{color.primitive.alpha.14}",
      "border-strong": "{color.primitive.ink.600}",
      "focus-ring": "{color.primitive.gold.300}",
      "brand": "{color.primitive.gold.500}",
      "brand-hover": "{color.primitive.gold.300}",
      "accent": "{color.primitive.rose.500}",
      "accent-fill": "{color.primitive.rose.700}",
      "danger": "{color.primitive.red.500}",
      "danger-fill": "{color.primitive.red.700}",
      "success": "{color.primitive.green.500}",
      "warning": "{color.primitive.gold.500}"
    }
  },

  "typography": {
    "family": {
      "sans": "var(--font-geist, system-ui), -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Inter, sans-serif",
      "sansNote": "The fallback inside var() is required: var(--font-geist) alone invalidates the whole declaration when next/font has not injected the variable, silently reverting the app to the browser default serif.",
      "serif": "'New York', Georgia, 'Iowan Old Style', 'Times New Roman', serif",
      "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace"
    },
    "size": {
      "micro":   { "value": "11px", "rule": "uppercase + .16em tracking + 700 weight ONLY. Never sentence case." },
      "xs":      { "value": "12px", "use": "timestamps, counts, secondary meta" },
      "sm":      { "value": "13px", "use": "dense UI, card captions" },
      "base":    { "value": "15px", "use": "body" },
      "md":      { "value": "17px" },
      "lg":      { "value": "20px" },
      "xl":      { "value": "24px" },
      "2xl":     { "value": "30px" },
      "3xl":     { "value": "clamp(28px, 3.4vw, 38px)" },
      "display": { "value": "clamp(38px, 5.6vw, 62px)" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800 },
    "leading": { "tight": 1.08, "snug": 1.25, "normal": 1.5, "relaxed": 1.65 },
    "tracking": { "display": "-.035em", "tight": "-.02em", "normal": "0", "wide": ".06em", "micro": ".16em" },
    "minimumSize": { "value": "11px", "note": "and only for uppercase tracked labels. Operable text is 12px+." }
  },

  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "7": "32px", "8": "40px", "9": "48px", "10": "64px", "11": "80px" },

  "radius": { "xs": "6px", "sm": "9px", "md": "12px", "lg": "16px", "xl": "20px", "2xl": "28px", "sheet": "22px 22px 0 0", "pill": "999px", "circle": "50%" },

  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.07)",
    "2": "0 6px 18px rgba(0,0,0,.48), 0 0 0 1px rgba(255,255,255,.07)",
    "3": "0 14px 40px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.10)",
    "4": "0 28px 70px rgba(0,0,0,.62), 0 0 0 1px rgba(255,255,255,.10)",
    "glow-brand": "0 6px 18px rgba(232,180,85,.26)",
    "glow-accent": "0 4px 14px rgba(194,44,76,.34)",
    "note": "On a dark canvas the hairline separates and the shadow gives depth. Never ship one without the other."
  },

  "motion": {
    "duration": { "instant": "90ms", "fast": "140ms", "base": "200ms", "slow": "300ms", "slower": "440ms" },
    "easing": {
      "standard": "cubic-bezier(.2, 0, 0, 1)",
      "entrance": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(.3, 0, 1, 1)",
      "spring": "cubic-bezier(.34, 1.4, .64, 1)"
    }
  },

  "zIndex": { "base": 0, "raised": 10, "dropdown": 20, "sticky": 30, "nav": 40, "backdrop": 100, "modal": 110, "story": 140, "toast": 150 },

  "layout": {
    "shell": { "nav": "230px", "feedMin": "500px", "feedMax": "630px", "rail": "280px", "gap": "80px" },
    "headerHeight": "59px",
    "tabbarHeight": "62px",
    "tapTarget": { "value": "44px", "rule": "WCAG 2.5.8 minimum. Non-negotiable." },
    "breakpoints": { "rail": "1180px", "desktop": "930px", "mobile": "720px" }
  }
}
