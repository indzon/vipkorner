{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vipkorner",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vipkorner-db",
      "database_id": "50c7b25d-1d17-4ab9-a70e-ab1f0405b8bd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vipkorner-media"
    }
  ]
}
